# ==============================================================================
# FleetUpdate-Hub - Environment Configuration Example
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://fleet_user:fleet_password_change_me@localhost:5432/fleetupdate?schema=public"

# AES-256-GCM Master Encryption Key (Must be 32 bytes / 64 hex characters)
# Generate with: openssl rand -hex 32
MASTER_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# JWT Secret for Session and API authentication
# Generate with: openssl rand -hex 32
JWT_SECRET="super_secret_jwt_key_at_least_32_characters_long"
JWT_EXPIRES_IN="8h"

# CORS Allowed Origins (Comma separated)
CORS_ORIGIN="http://localhost:3000,https://fleetupdate.local"

# Notifications (Webhooks)
DISCORD_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Default Initial Admin Credentials (used on first db seed)
INITIAL_ADMIN_EMAIL="admin@fleetupdate.local"
INITIAL_ADMIN_PASSWORD="FleetAdminChangeMeNow123!"
